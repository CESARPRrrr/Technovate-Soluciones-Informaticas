doctype html
html(lang='es')
    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1')
        meta(name='description', content='TECHNOVA - Soluciones Informáticas. Desarrollo web, diseño de experiencias y consultoría tecnológica.')
        meta(name='theme-color', content='#061A32')
        title TECHNOVA | Soluciones Informáticas
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(href='css/bootstrap-icons.min.css', rel='stylesheet')
        link(href='css/styles.css', rel='stylesheet')
    body
        a.skip-link(href='#contenido') Saltar al contenido

        nav.navbar.navbar-expand-lg.navbar-dark.site-nav.sticky-top(aria-label='Navegación principal')
            .container.px-4.px-lg-5
                a.navbar-brand.brand(href='#inicio', aria-label='TECHNOVA, inicio')
                    span.brand-mark(aria-hidden='true') T
                    | TECHNOVA
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#mainNavigation', aria-controls='mainNavigation', aria-expanded='false', aria-label='Abrir menú de navegación')
                    span.navbar-toggler-icon
                #mainNavigation.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.align-items-lg-center
                        li.nav-item
                            a.nav-link(href='#servicios') Servicios
                        li.nav-item
                            a.nav-link(href='#nosotros') Nosotros
                        li.nav-item
                            a.nav-link(href='#equipo') Equipo
                        li.nav-item
                            a.nav-link(href='#contacto') Contacto
                        li.nav-item.ms-lg-3
                            a.btn.btn-nav(href='#contacto') Hablemos

        main#contenido
            header#inicio.hero
                .container.px-4.px-lg-5
                    .row.align-items-center.g-5
                        .col-lg-6
                            p.eyebrow
                                span.eyebrow-dot(aria-hidden='true')
                                | SOLUCIONES DIGITALES · TECHNOVA
                            h1 Innovación que transforma. Soluciones tecnológicas para un futuro digital.
                            p.hero-copy Una propuesta TECHNOVA para convertir ideas en experiencias digitales claras, seguras y preparadas para crecer.
                            .d-flex.flex-column.flex-sm-row.gap-3.hero-actions
                                a.btn.btn-accent.btn-lg(href='#servicios') Explorar servicios
                                a.btn.btn-outline-light.btn-lg(href='#nosotros')
                                    | Conoce TECHNOVA
                                    i.bi.bi-arrow-down-right.ms-2(aria-hidden='true')
                            p.hero-note Estrategia, diseño y tecnología orientados al valor real del negocio.
                        .col-lg-6
                            .hero-visual(aria-label='Ilustración conceptual de soluciones digitales', role='img')
                                .visual-orbit.orbit-one
                                .visual-orbit.orbit-two
                                .visual-card.visual-main
                                    .visual-card-top
                                        span.visual-dot
                                        span.visual-dot
                                        span.visual-dot
                                        span.visual-label TECH / NOVA
                                    .visual-grid
                                        .visual-grid-copy
                                            span.visual-kicker IDEA + TECNOLOGÍA
                                            span.visual-line
                                            span.visual-line.short
                                        .visual-grid-symbol(aria-hidden='true')
                                            i.bi.bi-braces
                                    .visual-bottom
                                        span.visual-bottom-mark(aria-hidden='true')
                                        span Soluciones digitales
                                        i.bi.bi-arrow-up-right(aria-hidden='true')
                                .visual-chip.chip-code
                                    i.bi.bi-code-slash(aria-hidden='true')
                                    span Desarrollo web
                                .visual-chip.chip-spark
                                    i.bi.bi-stars(aria-hidden='true')
                                    span Innovación aplicada

            section#servicios.section-space.services-section(aria-labelledby='services-title')
                .container.px-4.px-lg-5
                    .section-heading.row.align-items-end.g-3
                        .col-lg-7
                            p.section-kicker LO QUE HACEMOS
                            h2#services-title Soluciones que impulsan tu negocio.
                        .col-lg-5
                            p.section-intro Diseñamos y ejecutamos propuestas digitales con foco en claridad, funcionalidad y resultados sostenibles.
                    .row.g-4
                        .col-md-6.col-xl-4
                            article.service-card.h-100
                                .service-icon(aria-hidden='true')
                                    i.bi.bi-window-stack
                                span.service-number 01 / WEB
                                h3 Desarrollo web
                                p Sitios y plataformas digitales adaptables, accesibles y pensados para comunicar valor con impacto real.
                                a.card-link(href='#contacto')
                                    | Hablemos de tu proyecto
                                    i.bi.bi-arrow-up-right(aria-hidden='true')
                        .col-md-6.col-xl-4
                            article.service-card.h-100
                                .service-icon(aria-hidden='true')
                                    i.bi.bi-bezier2
                                span.service-number 02 / DISEÑO
                                h3 Diseño de experiencias
                                p Interfaces claras, coherentes y eficaces que simplifican procesos y refuerzan la confianza de tus usuarios.
                                a.card-link(href='#contacto')
                                    | Hablemos de tu proyecto
                                    i.bi.bi-arrow-up-right(aria-hidden='true')
                        .col-md-6.col-xl-4
                            article.service-card.h-100
                                .service-icon(aria-hidden='true')
                                    i.bi.bi-lightbulb
                                span.service-number 03 / ASESORÍA
                                h3 Consultoría tecnológica
                                p Acompañamiento estratégico para definir prioridades, optimizar decisiones y avanzar con criterio digital.
                                a.card-link(href='#contacto')
                                    | Hablemos de tu proyecto
                                    i.bi.bi-arrow-up-right(aria-hidden='true')

            section#nosotros.about-section.section-space(aria-labelledby='about-title')
                .container.px-4.px-lg-5
                    .row.align-items-center.g-5
                        .col-lg-6
                            .about-visual
                                .about-visual-label
                                    span.about-label-mark(aria-hidden='true')
                                    | INNOVACIÓN CON PROPÓSITO
                                .about-visual-content
                                    span.about-big-type T<span>.</span>
                                    p Soluciones pensadas para crecer con claridad.
                                .about-visual-foot
                                    span PERSONAS
                                    span IDEAS
                                    span TECNOLOGÍA
                        .col-lg-6
                            p.section-kicker QUIÉNES SOMOS
                            h2#about-title Una visión tecnológica construida en equipo.
                            p.about-lead TECHNOVA presenta una propuesta de soluciones digitales para proyectos que buscan fortalecer su presencia en línea y explorar oportunidades tecnológicas.
                            p.about-copy La oferta de servicios, el alcance operativo y la información institucional están pendientes de validación antes de presentarse como definitivos.
                            a.btn.btn-dark-custom(href='#equipo')
                                | Conoce al equipo
                                i.bi.bi-arrow-right.ms-2(aria-hidden='true')

            section#proceso.process-section.section-space(aria-labelledby='process-title')
                .container.px-4.px-lg-5
                    .row.g-5
                        .col-lg-4
                            p.section-kicker CÓMO TRABAJAMOS
                            h2#process-title Del reto a una solución con sentido.
                            p.section-intro Un proceso colaborativo pensado para entender objetivos, priorizar decisiones y construir soluciones útiles.
                        .col-lg-8
                            ol.process-list
                                li.process-item
                                    span.process-index 01
                                    div
                                        h3 Escuchar
                                        p Analizamos contexto, objetivos y necesidades para definir una base sólida.
                                li.process-item
                                    span.process-index 02
                                    div
                                        h3 Definir
                                        p Establecemos prioridades, alcance y una dirección clara para cada iniciativa.
                                li.process-item
                                    span.process-index 03
                                    div
                                        h3 Diseñar y construir
                                        p Diseñamos y desarrollamos soluciones con foco en utilidad, accesibilidad y experiencia de usuario.
                                li.process-item
                                    span.process-index 04
                                    div
                                        h3 Mejorar
                                        p Validamos resultados, refinamos detalles y dejamos la solución preparada para evolucionar.

            section#equipo.team-section.section-space(aria-labelledby='team-title')
                .container.px-4.px-lg-5
                    .section-heading.row.align-items-end.g-3
                        .col-lg-7
                            p.section-kicker DETRÁS DE TECHNOVA
                            h2#team-title Nuestro equipo.
                        .col-lg-5
                            p.section-intro Conoce a las personas que lideran TECHNOVA.
                    .row.g-4
                        .col-md-6
                            article.team-card.h-100
                                .team-photo.team-photo-cp
                                    img(src='assets/cesar-pina.jpg', alt='César Piña, Director General de TECHNOVA', loading='lazy', width='768', height='750')
                                .team-card-body
                                    span.team-role Director General (CEO)
                                    h3 César Piña
                                    p Dirección general de TECHNOVA.
                        .col-md-6
                            article.team-card.h-100
                                .team-photo.team-photo-mb
                                    img(src='assets/manuel-barsik.jpg', alt='Manuel Barsik, Director de Tecnología y Operaciones de TECHNOVA', loading='lazy', width='768', height='750')
                                .team-card-body
                                    span.team-role Director de Tecnología y Operaciones (CTO/COO)
                                    h3 Manuel Barsik
                                    p Liderazgo de tecnología y operaciones.
                        .col-md-6
                            article.team-card.h-100
                                .team-photo
                                    img(src='assets/asistente-atencion-cliente.png', alt='Katerina Gutiérrez, Asistente de Atención al Cliente de TECHNOVA', loading='lazy', width='768', height='750')
                                .team-card-body
                                    span.team-role Asistente de Atención al Cliente
                                    h3 Katerina Gutiérrez
                                    p Apoyo en la atención de consultas, recepción de solicitudes y orientación a los clientes sobre los servicios de TECHNOVA.
                        .col-md-6
                            article.team-card.h-100
                                .team-photo
                                    img(src='assets/asistente-gestion-administrativa.png', alt='Betzabeth Medina, Asistente de Gestión Administrativa de TECHNOVA', loading='lazy', width='768', height='750')
                                .team-card-body
                                    span.team-role Asistente de Gestión Administrativa
                                    h3 Betzabeth Medina
                                    p Apoyo en la organización administrativa y coordinación de las actividades internas de TECHNOVA.

            section#contacto.contact-section.section-space(aria-labelledby='contact-title')
                .container.px-4.px-lg-5
                    .row.g-5
                        .col-lg-5.contact-intro
                            p.section-kicker EMPECEMOS UNA CONVERSACIÓN
                            h2#contact-title Cuéntanos sobre tu proyecto.
                            p Completa el formulario y el equipo de TECHNOVA recibirá tu mensaje.
                            .contact-detail
                                i.bi.bi-send(aria-hidden='true')
                                span El formulario utiliza Formspree para procesar y entregar tu mensaje.
                        .col-lg-7
                            form#contactForm.contact-form(action='https://formspree.io/f/xkjjlwdr', method='POST')
                                .row.g-3
                                    .col-md-6
                                        label.form-label(for='contactName') Nombre
                                        input#contactName.form-control(type='text', name='name', autocomplete='name', required, maxlength='120')
                                    .col-md-6
                                        label.form-label(for='contactEmail') Correo electrónico
                                        input#contactEmail.form-control(type='email', name='email', autocomplete='email', required, maxlength='254')
                                    .col-12
                                        label.form-label(for='contactPhone')
                                            | Teléfono
                                            span.optional-label  (opcional)
                                        input#contactPhone.form-control(type='tel', name='phone', autocomplete='tel', maxlength='40')
                                    .col-12
                                        label.form-label(for='contactMessage') Mensaje
                                        textarea#contactMessage.form-control(name='message', rows='5', required, minlength='10', maxlength='5000')
                                    .col-12
                                        button.btn.btn-accent(type='submit') Enviar mensaje
                                        p.form-note Los datos enviados se procesan mediante Formspree para entregar tu consulta.
                                        p#formStatus.form-status(role='status', aria-live='polite')

        footer.site-footer
            .container.px-4.px-lg-5
                .row.align-items-center.g-3
                    .col-md-6
                        a.footer-brand(href='#inicio') TECHNOVA
                        p.footer-note Soluciones tecnológicas para crecimiento, innovación y confianza.
                    .col-md-6.text-md-end
                        p.footer-credit
                            | Diseño adaptado desde
                            a(href='https://github.com/StartBootstrap/startbootstrap-business-frontpage', target='_blank', rel='noopener noreferrer') Start Bootstrap Business Frontpage
                            | .
                        p.footer-copy © TECHNOVA · Identidad corporativa en evolución.
                .footer-bottom
                    span Atribuciones y licencia MIT de la plantilla original documentadas en el repositorio.

        script(src='js/scripts.js')
